      "isDeleted": false,
      "boundElements": null,
      "updated": 1785314346223,
      "link": null,
      "locked": false,
      "text": "Interview Question\n\n    Suppose tomorrow the interviewer says:\n    \"Add XML Formatter.\"\n    \n    How much existing code changes?\n    Answer: Zero.",
