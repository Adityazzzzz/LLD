      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Interview Question\n\n    Suppose tomorrow the interviewer says:\n    \"Add XML Formatter.\"\n    \n    How much existing code changes?\n    Answer: Zero.",
      "autoResize": true,
      "lineHeight": 1.25
    },
